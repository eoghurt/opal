{
  "name": "opal",
  "productName": "Opal",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first notes app. Markdown files on disk are the source of truth.",
  "main": "main.js",
  "scripts": {
    "build": "rm -rf dist && esbuild src/renderer.js --bundle --splitting --format=esm --minify --outdir=dist --loader:.woff2=file --loader:.woff=file --sourcemap && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs dist/",
    "start": "npm run build && electron .",
    "dist": "npm run build && ELECTRON_CACHE=.build-cache/electron ELECTRON_BUILDER_CACHE=.build-cache electron-builder --mac dir"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "codemirror": "^6.0.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "app.opal.notes",
    "productName": "Opal",
    "copyright": "Opal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "file-types.json",
      "shared/**",
      "src/index.html",
      "src/styles.css",
      "dist/**",
      "!dist/**/*.map",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSHumanReadableCopyright": "Your notes are plain markdown files on disk."
      }
    }
  }
}
