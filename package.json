{
  "name": "opal",
  "productName": "Opal",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first notes app. Markdown files on disk are the source of truth.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/renderer.js --bundle --outdir=dist --loader:.woff2=file --loader:.woff=file --sourcemap",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
