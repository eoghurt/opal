    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2"
  }
}
