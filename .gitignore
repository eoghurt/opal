# Mac clutter
.DS_Store

# Downloaded libraries (npm install brings them back)
node_modules/

# Built by `npm run build` / `npm run dist`
dist/
release/
.build-cache/

# Logs and local secrets, never uploaded
*.log
npm-debug.log*
.env
.env.*

# End-to-end test runs (a scratch copy of the demo vault, test app data)
tests/e2e/.run/
